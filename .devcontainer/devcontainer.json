{
  "name": "CSC 139 - A0 C Warm-Up",
  "build": { "dockerfile": "Dockerfile" },

  // Same capabilities as Assignment 1, so the environment you learn in is the
  // environment you will be graded in.
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.cStandard": "c17",
        "files.eol": "\n"
      }
    }
  },

  "postCreateCommand": "make check-env",
  "remoteUser": "vscode"
}
